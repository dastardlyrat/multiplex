{
  "name": "url-forensics",
  "version": "0.3.0",
  "description": "Tooling and checks for the URL Forensics Workbench Firefox extension.",
  "main": "index.js",
  "scripts": {
    "build:extension": "node tools/run-web-ext.js build --source-dir \"lab/firefox-extension\" --artifacts-dir \"web-ext-artifacts\" --overwrite-dest",
    "check": "npm run check:syntax && npm run lint:js && npm run lint:extension && npm run duplicates && npm run check:resources && npm run smoke",
    "check:detector-parity": "node tools/check-detector-parity.js",
    "check:resources": "node tools/check-extension-resources.js",
    "check:syntax": "node tools/check-syntax.js",
    "duplicates": "jscpd \"lab/firefox-extension\" --format javascript --min-lines 10 --min-tokens 80 --max-lines 10000 --max-size 1mb --reporters console --ignore \"**/resources/fonts/**\"",
    "lint:extension": "node tools/run-web-ext.js lint --source-dir \"lab/firefox-extension\" --self-hosted",
    "lint:js": "eslint \"lab/firefox-extension/**/*.js\"",
    "rebuild:catalog-goldens": "node tools/rebuild-catalog-goldens.js",
    "rebuild:diagnostics-health": "node tools/rebuild-diagnostics-health.js",
    "rebuild:sample-review-data": "node tools/rebuild-sample-review-data.js",
    "rebuild:test-suite": "node tools/rebuild-test-suite.js",
    "rebuild:test-suite:all": "npm run rebuild:test-suite && npm run smoke",
    "smoke": "node tools/smoke-pipeline.js",
    "smoke:save": "node tools/smoke-pipeline.js --save",
    "test": "npm run check",
    "test:pipeline": "npm run smoke",
    "test:pipeline:save": "npm run smoke:save"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "cspell": "^10.0.0",
    "dependency-cruiser": "^17.3.10",
    "eslint": "9.39.4",
    "globals": "14.0.0",
    "jscpd": "^4.0.8",
    "knip": "^6.3.0",
    "prettier": "^3.8.1",
    "web-ext": "^10.1.0"
  }
}
