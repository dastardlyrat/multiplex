{
  "manifest_version": 3,
  "name": "URL Forensics Workbench",
  "version": "0.3.0",
  "description": "Turn detected email bodies into a URL forensics side panel.",
  "permissions": [
    "clipboardWrite",
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "Open URL Forensics Workbench controls and settings hub",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self'; font-src 'self'; object-src 'self';"
  },
  "background": {
    "scripts": [
      "debug-redaction.js",
      "debug.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://*.mail.google.com/*",
        "https://outlook.office.com/*",
        "https://*.outlook.office.com/*",
        "https://outlook.live.com/*",
        "https://*.outlook.live.com/*",
        "https://outlook.office365.com/*",
        "https://*.outlook.office365.com/*",
        "https://mail.yahoo.com/*",
        "https://*.mail.yahoo.com/*",
        "https://mail.proton.me/*",
        "https://*.mail.proton.me/*",
        "https://app.hey.com/*",
        "https://*.app.hey.com/*",
        "https://app.fastmail.com/*",
        "https://*.app.fastmail.com/*"
      ],
      "css": [
        "page-pane.css"
      ],
      "js": [
        "debug-redaction.js",
        "debug.js",
        "pipeline-default-plugin.js",
        "pipeline-plugin-registry.js",
        "tracking-parameter-model.js",
        "pipeline-base.js",
        "pipeline-url-resolver.js",
        "pipeline-html-rewriter.js",
        "pipeline-detector-registry.js",
        "pipeline-detection.js",
        "pipeline-resolution.js",
        "pipeline-assembly.js",
        "pipeline-diagnostics.js",
        "pipeline-stage-runner.js",
        "pipeline.js",
        "storage-model.js",
        "inbox-detector-registry.js",
        "inbox-detectors.js",
        "content-ui-helpers.js",
        "content-page-context.js",
        "page-pane-diagnostics.js",
        "page-pane-shell.js",
        "page-pane-bootstrap.js",
        "page-pane-assembly.js",
        "page-pane-layout.js",
        "page-pane-mirror.js",
        "page-pane-snapshot.js",
        "email-snapshot-sync.js",
        "email-root-summary.js",
        "email-root-runtime.js",
        "email-auto-replace-state.js",
        "email-auto-replace.js",
        "content-settings-storage.js",
        "content-runtime-lifecycle.js",
        "email-candidate-discovery.js",
        "content-pane-workflows.js",
        "content-inbox-workflows.js",
        "content-workflow-accessors.js",
        "content-script-runtime.js",
        "settings-opener.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "core-components/extension-workbench.html",
        "icons.css",
        "app.css",
        "app.js",
        "debug-redaction.js",
        "debug.js",
        "pipeline-default-plugin.js",
        "pipeline-plugin-registry.js",
        "tracking-parameter-model.js",
        "storage-model.js",
        "pipeline-base.js",
        "pipeline-url-resolver.js",
        "pipeline-html-rewriter.js",
        "pipeline-detector-registry.js",
        "pipeline-detection.js",
        "pipeline-resolution.js",
        "pipeline-assembly.js",
        "pipeline-diagnostics.js",
        "pipeline-stage-runner.js",
        "pipeline.js",
        "settings-opener.js",
        "core-components/components.css",
        "core-components/components.js",
        "resources/fonts/material-symbols-outlined.woff2",
        "resources/fonts/material-symbols-rounded.woff2",
        "resources/fonts/material-symbols-sharp.woff2"
      ],
      "matches": [
        "https://mail.google.com/*",
        "https://*.mail.google.com/*",
        "https://outlook.office.com/*",
        "https://*.outlook.office.com/*",
        "https://outlook.live.com/*",
        "https://*.outlook.live.com/*",
        "https://outlook.office365.com/*",
        "https://*.outlook.office365.com/*",
        "https://mail.yahoo.com/*",
        "https://*.mail.yahoo.com/*",
        "https://mail.proton.me/*",
        "https://*.mail.proton.me/*",
        "https://app.hey.com/*",
        "https://*.app.hey.com/*",
        "https://app.fastmail.com/*",
        "https://*.app.fastmail.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "url-forensics-workbench@urlforensics.local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "142.0"
    }
  }
}
