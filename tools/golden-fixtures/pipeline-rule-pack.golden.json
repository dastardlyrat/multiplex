{
  "pluginPacks": [
    {
      "id": "builtin-default",
      "title": "Built-in URL Forensics rule pack",
      "priority": 0,
      "detection": {
        "urlTokenPattern": {
          "source": "https?:\\/\\/[^\\s<>\"']+",
          "flags": "gi"
        },
        "repairableUrlTokenPatterns": [
          {
            "id": "protocol-whitespace-token",
            "pattern": {
              "source": "(?:^|[^a-z])(https?:\\/\\/\\s+[^\\s<>\"']+)",
              "flags": "gi"
            },
            "tokenGroupIndex": 1
          },
          {
            "id": "protocol-single-slash-token",
            "pattern": {
              "source": "(?:^|[^a-z])(https?:\\/(?!\\/)[^\\s<>\"']+)",
              "flags": "gi"
            },
            "tokenGroupIndex": 1
          },
          {
            "id": "protocol-missing-colon-token",
            "pattern": {
              "source": "(?:^|[^a-z])(https?\\/\\/[^\\s<>\"']+)",
              "flags": "gi"
            },
            "tokenGroupIndex": 1
          },
          {
            "id": "protocol-missing-leading-h-token",
            "pattern": {
              "source": "(?:^|[^a-z])(ttps?:\\/\\/[^\\s<>\"']+)",
              "flags": "gi"
            },
            "tokenGroupIndex": 1
          }
        ],
        "trailingUrlPunctuationPattern": {
          "source": "[)\\]\\.,>]+$",
          "flags": ""
        },
        "wrappedNoisePattern": {
          "source": "[<>]",
          "flags": "g"
        },
        "lightweightWhitespaceNoisePattern": {
          "source": "[\\u2000-\\u200F\\u2028-\\u202F]",
          "flags": "g"
        },
        "heavyWhitespaceNoisePattern": {
          "source": "[\\u00AD\\u034F\\u061C\\u115F\\u1160\\u17B4\\u17B5\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u2060-\\u206F\\uFEFF]",
          "flags": "g"
        },
        "protectedMarkupTagPattern": {
          "source": "^(A|SCRIPT|STYLE|NOSCRIPT|TEXTAREA|PRE|CODE)$",
          "flags": "i"
        },
        "embeddedTrackingParameterPattern": {
          "source": "[?&](?:url|u|target|redirect|redirect_url|dest|destination|next|forward|goto|continue|to|href|link|data)=([^&]+)",
          "flags": "gi"
        }
      },
      "tracking": {
        "preferredTrackingParameterNames": [
          "url",
          "u",
          "target",
          "redirect",
          "redirect_url",
          "dest",
          "destination",
          "next",
          "forward",
          "goto",
          "continue",
          "to",
          "href",
          "link",
          "data"
        ],
        "trackerHostKeywords": [
          "list-manage",
          "rs6.net",
          "ccsend.com",
          "kajabimail",
          "mail",
          "tracking",
          "redirect",
          "click"
        ],
        "trackingParameterDefinitions": [
          {
            "key": "utmPrefix",
            "bucket": "safe",
            "label": "utm_*",
            "parameterName": "utm_",
            "matchMode": "prefix",
            "description": "Remove any UTM campaign parameter whose name starts with utm_."
          },
          {
